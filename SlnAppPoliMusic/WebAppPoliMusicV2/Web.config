<?xml version="1.0" encoding="utf-8"?>
<!--
  PoliMusic - Configuracion de la aplicacion web (Web Application Project, .NET 4.8)

  La cadena de conexion es la MISMA que ya existia en el proyecto y apunta a
  la base BDD_PoliMusic creada por BDD_PoliMusic.sql:

      Servidor : localhost
      Base     : BDD_PoliMusic
      Usuario  : usr_polimusic
      Clave    : Politecnica1

  Si su instancia de SQL Server usa otro servidor o credenciales, cambie
  unicamente el atributo connectionString de BDD_PoliMusicConnectionString.
-->
<configuration>

  <appSettings>
    <!-- 50 MB = 50 * 1024 * 1024 bytes. Limite para archivos mp3. -->
    <add key="maxSongLength" value="52428800" />
    <!-- Carpetas de recursos. La base de datos guarda rutas ~/carpeta/archivo. -->
    <add key="albumImagePath" value="~/AlbumImages/" />
    <add key="artistImagePath" value="~/ArtistImages/" />
    <add key="userPhotoPath" value="~/UserImages/" />
    <add key="songFolderPath" value="~/SongFiles/" />
    <add key="playlistFolderPath" value="~/PlaylistImages/" />
  </appSettings>

  <connectionStrings>
    <add name="BDD_PoliMusicConnectionString"
         connectionString="Data Source=localhost;Initial Catalog=BDD_PoliMusic;User ID=usr_polimusic;Password=Politecnica1"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- 51200 KB = 50 MB para la subida de archivos -->
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" executionTimeout="300" />

    <!-- La autenticacion se resuelve con sesion propia (Util/UserSession) y
         PageBase. No se usa FormsAuthentication para no mezclar mecanismos. -->
    <authentication mode="None" />

    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />

    <!-- Lectura de los .aspx como UTF-8 (tildes y enie en la interfaz). -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Auto">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Web" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="WebAppPoliMusicV2" />
        <add namespace="WebAppPoliMusicV2.Entities" />
        <add namespace="WebAppPoliMusicV2.BLL" />
        <add namespace="WebAppPoliMusicV2.DAL" />
        <add namespace="WebAppPoliMusicV2.Util" />
      </namespaces>
    </pages>

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <machineKey validation="HMACSHA256" decryption="AES" />
  </system.web>

  <!-- El registro es publico; el resto de paginas exige sesion desde PageBase. -->
  <location path="SignUp.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- 52428800 bytes = 50 MB -->
        <requestLimits maxAllowedContentLength="52428800" />

        <!--
          NO declarar aqui <fileExtensions> ni <denyUrlSequences>.

          IIS ya deniega en su configuracion base (applicationHost.config) las
          extensiones .cs, .csproj, .config, .master, .asax, .resx, etc., y ya
          trata web.config como hiddenSegment. Volver a declararlas produce:

              HTTP 500.19 - 0x800700b7
              "No se puede agregar una entrada de coleccion duplicada de tipo
               'add' con un atributo de clave unica 'fileExtension'"

          Ademas, un denyUrlSequences con "Web.config" bloquearia busquedas
          legitimas del tipo Canciones.aspx?q=web.config.
        -->
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
