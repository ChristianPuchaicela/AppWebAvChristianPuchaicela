<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="WebAppPoliMusicV1.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">PoliMusic</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/Site.css") %>" />
    <script>window.pmBase = '<%= ResolveUrl("~/") %>'; window.pmToken = '<%= CsrfToken %>';</script>
</head>
<body>
<form id="pmForm" runat="server">
    <div class="pm-shell">

        <aside class="pm-sidebar">
            <a class="pm-brand" href="<%= ResolveUrl("~/Default.aspx") %>">
                <span class="pm-brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#F3E4E7" stroke-width="2" stroke-linecap="round">
                        <path d="M9 18V5l10-2v13" />
                        <circle cx="6" cy="18" r="3" fill="#F3E4E7" stroke="none" />
                        <circle cx="16" cy="16" r="3" fill="#F3E4E7" stroke="none" />
                    </svg>
                </span>
                <span class="pm-brand-text">
                    <span class="pm-brand-name">PoliMusic</span>
                    <span class="pm-brand-sub">Streaming</span>
                </span>
            </a>

            <nav class="pm-nav">
                <span class="pm-nav-label">Explorar</span>
                <a href="<%= ResolveUrl("~/Default.aspx") %>" class="<%= NavClass("home") %>">Inicio</a>
                <a href="<%= ResolveUrl("~/Canciones.aspx") %>" class="<%= NavClass("songs") %>">Canciones</a>
                <a href="<%= ResolveUrl("~/Artistas.aspx") %>" class="<%= NavClass("artists") %>">Artistas</a>
                <a href="<%= ResolveUrl("~/Albumes.aspx") %>" class="<%= NavClass("albums") %>">Álbumes</a>

                <span class="pm-nav-label">Mi música</span>
                <a href="<%= ResolveUrl("~/Playlists.aspx") %>" class="<%= NavClass("playlists") %>">Playlists</a>
                <a href="<%= ResolveUrl("~/Perfil.aspx") %>" class="<%= NavClass("profile") %>">Mi perfil</a>

                <% if (IsAdminUser) { %>
                <span class="pm-nav-label">Administración</span>
                <a href="<%= ResolveUrl("~/Admin/Default.aspx") %>" class="<%= NavClass("admin") %>">Panel</a>
                <a href="<%= ResolveUrl("~/Admin/Usuarios.aspx") %>" class="<%= NavClass("admin-users") %>">Usuarios</a>
                <a href="<%= ResolveUrl("~/Admin/Canciones.aspx") %>" class="<%= NavClass("admin-songs") %>">Canciones</a>
                <a href="<%= ResolveUrl("~/Admin/Artistas.aspx") %>" class="<%= NavClass("admin-artists") %>">Artistas</a>
                <a href="<%= ResolveUrl("~/Admin/Albumes.aspx") %>" class="<%= NavClass("admin-albums") %>">Álbumes</a>
                <a href="<%= ResolveUrl("~/Admin/Playlists.aspx") %>" class="<%= NavClass("admin-playlists") %>">Playlists</a>
                <% } %>
            </nav>
        </aside>

        <div class="pm-main">
            <header class="pm-topbar">
                <div class="pm-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-3.5-3.5" />
                    </svg>
                    <input type="text" id="pmSearchInput" placeholder="Buscar canciones, artistas o álbumes…"
                           value="<%= SearchValue %>" aria-label="Buscar" />
                </div>

                <div class="pm-topbar-actions">
                    <div class="pm-welcome">
                        <span>Bienvenido</span>
                        <strong><%= H(CurrentUsername) %></strong>
                        <span class="pm-role"><%= CurrentRoleName %></span>
                    </div>
                    <a href="<%= ResolveUrl("~/Perfil.aspx") %>" title="Mi perfil">
                        <% if (!string.IsNullOrEmpty(CurrentPhotoUrl)) { %>
                        <img class="pm-avatar" src="<%= Url(CurrentPhotoUrl) %>" alt="Foto de perfil" />
                        <% } else { %>
                        <span class="pm-avatar-fallback"><%= H(Initials) %></span>
                        <% } %>
                    </a>
                    <a class="pm-btn pm-btn-ghost pm-btn-sm" href="<%= ResolveUrl("~/Logout.aspx") %>">Cerrar sesión</a>
                </div>
            </header>

            <main class="pm-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </div>

    <!-- Barra de reproduccion persistente -->
    <div class="pm-player" id="pmPlayer">
        <div class="pm-player-info">
            <div class="pm-player-art" id="pmPlayerArt"><span class="pm-art-initials">♪</span></div>
            <div class="pm-player-meta">
                <div class="pm-player-title" id="pmPlayerTitle">Sin reproducción</div>
                <div class="pm-player-artist" id="pmPlayerArtist">PoliMusic</div>
            </div>
        </div>

        <div class="pm-player-center">
            <div class="pm-player-controls">
                <button type="button" class="pm-ctrl" id="pmPrev" aria-label="Anterior">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 6h2v12H7zM19 6l-9 6 9 6z"/></svg>
                </button>
                <button type="button" class="pm-ctrl pm-ctrl-main" id="pmPlayPause" aria-label="Reproducir">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </button>
                <button type="button" class="pm-ctrl" id="pmNext" aria-label="Siguiente">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 6h2v12h-2zM5 6l9 6-9 6z"/></svg>
                </button>
            </div>
            <div class="pm-player-track">
                <span class="pm-time" id="pmTimeCurrent">0:00</span>
                <div class="pm-progress" id="pmProgress" role="slider" aria-label="Progreso">
                    <div class="pm-progress-fill" id="pmProgressFill"></div>
                </div>
                <span class="pm-time right" id="pmTimeTotal">0:00</span>
            </div>
        </div>

        <div class="pm-player-right">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M11 5L6 9H2v6h4l5 4V5z" />
                <path d="M15.5 8.5a5 5 0 010 7" />
            </svg>
            <div class="pm-volume" id="pmVolume" role="slider" aria-label="Volumen">
                <div class="pm-volume-fill" id="pmVolumeFill"></div>
            </div>
        </div>
    </div>

    <div class="pm-toast" id="pmToast" role="status" aria-live="polite"></div>
</form>
<script src="<%= ResolveUrl("~/Scripts/pollmusic.js") %>"></script>
</body>
</html>
