<?xml version="1.0"?>
<!--
  PoliMusic - Plantilla de configuracion de secretos (SI versionada).

  Copie este archivo a "Web.secrets.config" en el mismo directorio y sustituya
  los valores por los de su instancia de SQL Server. El archivo resultante
  esta excluido por .gitignore y no se subira al repositorio.

  Ejemplo rapido en Windows:
      copy Web.secrets.config.example Web.secrets.config

  FORMATO (importante): la raiz de este documento es <connectionStrings>,
  SIN envolverlo en <configuration>. Es el formato que exige configSource.

  Notas sobre la cadena de conexion:
    Server      instancia y puerto. Ej: localhost,1433  o  .\SQLEXPRESS
    Database    nombre de la base creada con BDD_PoliMusic.sql
    User Id     usuario SQL con permiso sobre la base (vea README.md seccion 1)
    Password    contrasena de ese usuario
    Encrypt / TrustServerCertificate
                valores habituales para desarrollo local con certificado
                autofirmado. En produccion use un certificado valido.
-->
<connectionStrings>
  <add name="PoliMusicConnection"
       connectionString="Server=localhost,1433;Database=BDD_PoliMusic;User Id=SU_USUARIO;Password=SU_CONTRASENA;Encrypt=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
       providerName="System.Data.SqlClient" />
</connectionStrings>
